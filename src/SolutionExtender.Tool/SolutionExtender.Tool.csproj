<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>solutionextender</ToolCommandName>
    <PackageId>SolutionExtender</PackageId>
    <Version>0.1.0</Version>
    <Authors>SolutionExtender contributors</Authors>
    <Description>Capture versioned deployment metadata for PAC solutions and reconcile unmanaged Dataverse deployments.</Description>
    <RepositoryUrl>https://github.com/context-and-oss/SolutionExtender</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SolutionExtender.Core/SolutionExtender.Core.csproj" />
    <PackageReference Include="DataverseConnection" Version="1.2.5" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
